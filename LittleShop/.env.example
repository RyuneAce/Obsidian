# HACQUIRE 2026 Environment Configuration

# Gemini API Key (Required for Voice Commerce & Bill OCR)
# Voice Commerce uses this to extract strict JSON intents from spoken Hindi/English transcripts.
# Bill OCR uses this to extract transaction structured data from receipts.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Note: In the hackathon MVP, the UI also provides a fallback where 
# the user can manually enter this key via the settings panel, 
# saving it securely to browser LocalStorage.
